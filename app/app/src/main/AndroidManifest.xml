<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M1 仅需基础权限；M2+ 按模块追加 CALL_PHONE / SEND_SMS / RECEIVE_SMS /
         READ_SMS / ACCESS_FINE_LOCATION / READ_PHONE_STATE 等 -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Zhiya"
        android:supportsRtl="true">

        <!-- 桌面入口：HOME + LAUNCHER，同时作为 kiosk 主界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设备管理员：dpm set-device-owner 绑定的组件 -->
        <receiver
            android:name=".admin.ZhiyaDeviceAdmin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="false">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
